<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="QuizApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:QuizApp.Views"
    Title="Вікторина">

    <TabBar>
        <ShellContent Title="Теми"
                      ContentTemplate="{DataTemplate views:TopicsPage}"
                      Route="topics" />
        <ShellContent Title="Історія"
                      ContentTemplate="{DataTemplate views:HistoryPage}"
                      Route="history" />
    </TabBar>

</Shell>
