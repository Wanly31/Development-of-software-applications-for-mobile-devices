<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             x:Class="QuizApp.Views.TopicsPage"
             x:DataType="vm:TopicsViewModel"
             Title="Вікторина">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Створити" Command="{Binding CreateCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Topics}" Margin="16,8">
        <CollectionView.Header>
            <VerticalStackLayout Margin="0,8,0,12">
                <Label Text="Оберіть тему" FontSize="22" FontAttributes="Bold" />
                <Label Text="Свою вікторину можна додати кнопкою «Створити» вгорі."
                       FontSize="12"
                       TextColor="Gray" />
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:TopicCard">
                <Border Margin="0,6"
                        Padding="16"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{StaticResource Primary}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TopicsViewModel}}, Path=StartCommand, x:DataType=vm:TopicsViewModel}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" />
                        <Label Text="{Binding Description}" />
                        <Label Text="{Binding Info}" FontSize="12" TextColor="Gray" />

                        <!-- Вбудовані теми змінювати не можна, кнопки лише для своїх. -->
                        <HorizontalStackLayout Spacing="8" Margin="0,8,0,0" IsVisible="{Binding IsCustom}">
                            <Button Text="Змінити"
                                    FontSize="12"
                                    Padding="12,4"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TopicsViewModel}}, Path=EditCommand, x:DataType=vm:TopicsViewModel}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="Видалити"
                                    FontSize="12"
                                    Padding="12,4"
                                    BackgroundColor="IndianRed"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TopicsViewModel}}, Path=DeleteCommand, x:DataType=vm:TopicsViewModel}"
                                    CommandParameter="{Binding .}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
