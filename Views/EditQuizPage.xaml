<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:QuizApp.ViewModels"
             xmlns:m="clr-namespace:QuizApp.Models"
             x:Class="QuizApp.Views.EditQuizPage"
             x:DataType="vm:EditQuizViewModel"
             Title="{Binding PageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Зберегти" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="Назва" FontAttributes="Bold" />
            <Entry Text="{Binding Name}" Placeholder="Наприклад, Кіно 90-х" />

            <Label Text="Опис" FontAttributes="Bold" />
            <Entry Text="{Binding Description}" Placeholder="Необов'язково" />

            <Border Padding="12" StrokeShape="RoundRectangle 10" Margin="0,8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Нове запитання" FontSize="18" FontAttributes="Bold" />
                    <Editor Text="{Binding QuestionText}" Placeholder="Текст запитання" AutoSize="TextChanges" />
                    <Entry Text="{Binding Correct}" Placeholder="Правильна відповідь" TextColor="SeaGreen" />
                    <Entry Text="{Binding Wrong1}" Placeholder="Неправильний варіант 1" />
                    <Entry Text="{Binding Wrong2}" Placeholder="Неправильний варіант 2 (необов'язково)" />
                    <Entry Text="{Binding Wrong3}" Placeholder="Неправильний варіант 3 (необов'язково)" />
                    <Button Text="Додати запитання" Command="{Binding AddQuestionCommand}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding Error}" TextColor="IndianRed" IsVisible="{Binding HasError}" />

            <Label Text="{Binding QuestionsHeader}" FontSize="18" FontAttributes="Bold" />

            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Questions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:Question">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,6">
                            <VerticalStackLayout>
                                <Label Text="{Binding Text}" FontAttributes="Bold" />
                                <Label Text="{Binding CorrectText}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="Прибрати"
                                    FontSize="12"
                                    Padding="10,4"
                                    BackgroundColor="IndianRed"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditQuizViewModel}}, Path=RemoveQuestionCommand, x:DataType=vm:EditQuizViewModel}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Button Text="Зберегти вікторину" Command="{Binding SaveCommand}" Margin="0,12" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
